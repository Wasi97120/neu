# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server Configuration
BASE_URL=https://your-domain.com
HOST=0.0.0.0
PORT=8000

# Agent Configuration
AGENT_NAME=KI-Assistent
AGENT_LANGUAGE=de
AGENT_SYSTEM_PROMPT=Du bist ein freundlicher und professioneller Telefonassistent. Sprich klar und deutlich. Halte dich kurz und komme auf den Punkt.
